{
  "name": "pi-provider-tokenflux",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.24.0",
  "description": "pi provider extension for TokenFlux",
  "author": "Twisuki",
  "license": "MIT",
  "homepage": "https://github.com/Twisuki/pi-provider-tokenflux#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Twisuki/pi-provider-tokenflux.git"
  },
  "bugs": {
    "url": "https://github.com/Twisuki/pi-provider-tokenflux/issues"
  },
  "keywords": [
    "pi-package",
    "tokenflux",
    "provider"
  ],
  "main": "src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "README_ZH.md",
    "src"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "pnpm check && pnpm lint",
    "check": "tsc --noEmit",
    "lint": "eslint",
    "fix": "eslint . --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
