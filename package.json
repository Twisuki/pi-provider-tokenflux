{
  "name": "pi-provider-tokenflux",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "description": "pi provider extension for TokenFlux",
  "author": "Twisuki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Twisuki/pi-provider-tokenflux.git"
  },
  "keywords": [
    "pi-package",
    "tokenflux"
  ],
  "main": "src/index.ts",
  "scripts": {
    "prepare": "husky",
    "check": "tsc --noEmit",
    "lint": "eslint",
    "fix": "eslint . --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
